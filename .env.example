APP_ENV=development
HOST=127.0.0.1
PORT=8080
API_KEY=replace-with-a-long-random-secret
INPUT_DIR=testdata/input
ALLOW_PRIVATE_SOURCES=true
RATE_LIMIT_PER_MINUTE=120
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=15s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

# Use "postgres" for a locally run Go server with DATABASE_URL, or use
# Docker Compose, which supplies PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE.
STORAGE_DRIVER=memory
QUEUE_DRIVER=memory
# RabbitMQ is enabled by Docker Compose; for local Go development set QUEUE_DRIVER=rabbitmq.
RABBITMQ_USER=pipeline
RABBITMQ_PASSWORD=replace-with-unique-rabbitmq-password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_QUEUE=pipeline.jobs
RABBITMQ_URL=amqp://pipeline:replace-with-unique-rabbitmq-password@127.0.0.1:5672/
# Optional exact hosts or patterns like *.example.org, comma-separated.
SOURCE_HOST_ALLOWLIST=
# Caddy profile only (requires public DNS pointing at server)
PIPELINE_DOMAIN=localhost
DATABASE_URL=postgresql://pipeline:replace-password@127.0.0.1:5433/pipeline?sslmode=disable

POSTGRES_USER=pipeline
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_DB=pipeline
POSTGRES_PORT=5433

MAX_CONCURRENT_JOBS=5
JOB_QUEUE_CAPACITY=100
JOB_RETENTION=24h
LOG_LEVEL=info
LOG_FORMAT=json
