    },
    {
      "name": "04 - Optional / Manual | Do not run by default",
      "description": "Manual scenarios only: PostgreSQL restart persistence, cancellation races, external HTTP, and deletion. Run requests individually, and never run destructive requests until persistence checks are complete.",
      "item": [
        {
          "name": "04.01 - Retrieve saved job AFTER Docker API restart",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/pipelines/{{jobId}}",
            "description": "Manual persistence test: create/finish job in folder 02, run docker compose restart api, then run this single request. Requires STORAGE_DRIVER=postgres."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const b = pm.response.json(); pm.test(\"Same persisted job ID\", () => pm.expect(b.job_id).to.eql(pm.collectionVariables.get(\"jobId\"))); pm.test(\"Persisted status\", () => pm.expect(b.status.state).to.eql(\"COMPLETED\")); }"
                ]
              }
            }
          ]
        },
        {
          "name": "04.02 - Read persisted results AFTER restart",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/pipelines/{{jobId}}/results",
            "description": "Run after restarting API without deleting the postgres_data volume."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { pm.test(\"Saved records persisted\", () => pm.expect(pm.response.json().records).to.have.lengthOf(5)); }"
                ]
              }
            }
          ]
        },
        {
          "name": "04.03 - Create separate cancellation job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/pipelines",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sources\": [\n    {\n      \"name\": \"cancel_csv\",\n      \"type\": \"csv\",\n      \"endpoint\": \"testdata/input/customers.csv\"\n    }\n  ],\n  \"worker_pool_sizes\": {\n    \"ingestion\": 1,\n    \"validation\": 1,\n    \"transformation\": 1\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Creates a short job. It may complete before the cancel request: 409 in that case is expected."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Job accepted\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"cancelJobId\", pm.response.json().job_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "04.04 - PATCH cancellation (timing dependent)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/pipelines/{{cancelJobId}}/cancel",
            "description": "Expect 202 if job is still pending/running, or 409 if it has already completed. For a reliable 202 test use a controlled slow HTTP source and allow it in your source policy."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Cancel accepted or job already completed\", () => pm.expect([202, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "04.05 - Create external HTTP API job (Internet required)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/pipelines",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sources\": [\n    {\n      \"name\": \"posts_api\",\n      \"type\": \"api\",\n      \"endpoint\": \"https://jsonplaceholder.typicode.com/posts\"\n    }\n  ],\n  \"validation_rules\": {\n    \"required_fields\": [\n      \"id\"\n    ]\n  },\n  \"timeout_seconds\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Optional. Requires outbound HTTPS DNS/network access from the API container; a 201 only means accepted, check /progress and /errors to see the execution result."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"External API job accepted\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"httpJobId\", pm.response.json().job_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "04.06 - External HTTP job progress",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/pipelines/{{httpJobId}}/progress",
            "description": "Poll if job is still running. External failures may show COMPLETED with recorded nonfatal errors."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.test(\"State is valid\", () => pm.expect([\"PENDING\",\"RUNNING\",\"COMPLETED\",\"FAILED\",\"CANCELLED\"]).to.include(pm.response.json().state));"
                ]
              }
            }
          ]
        },
        {
          "name": "04.07 - Delete saved sample job (destructive)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/pipelines/{{jobId}}",
            "description": "Run only when finished with persistence verification. This deletes your saved sample job."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Deleted terminal job 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "04.08 - Deleted job returns 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/pipelines/{{jobId}}",
            "description": "Run after 04.07."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Deleted job 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
