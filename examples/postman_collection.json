                  "pm.test(\"Unknown job 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "03.06 - PATCH cancel completed job returns 409",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/pipelines/{{jobId}}/cancel",
