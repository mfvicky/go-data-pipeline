    {
      "name": "02 - CSV + JSON Job | Run in order",
      "description": "Recommended end-to-end Postman Runner workflow (folder 02 only after folder 01). Creates a pipeline job, polls to completion, checks count/sum/avg group-by, exports config, progress, results, errors, pagination and metrics. Set collection variable apiKey first.",
      "item": [
        {
          "name": "02.01 - Create CSV + JSON job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/pipelines",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sources\": [\n    {\n      \"name\": \"customers_csv\",\n      \"type\": \"csv\",\n      \"endpoint\": \"testdata/input/customers.csv\"\n    },\n    {\n      \"name\": \"customers_json\",\n      \"type\": \"json\",\n      \"endpoint\": \"testdata/input/customers.json\"\n    }\n  ],\n  \"validation_rules\": {\n    \"required_fields\": [\n      \"id\",\n      \"city\",\n      \"amount\"\n    ]\n  },\n  \"transform_rules\": {\n    \"normalize\": [\n      \"city\"\n    ]\n  },\n  \"aggregations\": [\n    {\n      \"name\": \"count_by_city\",\n      \"operation\": \"count\",\n      \"group_by\": [\n        \"city\"\n      ]\n    },\n    {\n      \"name\": \"sum_amount_by_city\",\n      \"operation\": \"sum\",\n      \"field\": \"amount\",\n      \"group_by\": [\n        \"city\"\n      ]\n    },\n    {\n      \"name\": \"average_amount\",\n      \"operation\": \"avg\",\n      \"field\": \"amount\"\n    }\n  ],\n  \"worker_pool_sizes\": {\n    \"ingestion\": 2,\n    \"validation\": 3,\n    \"transformation\": 3\n  },\n  \"timeout_seconds\": 30,\n  \"exports\": [\n    {\n      \"type\": \"json\",\n      \"path\": \"output/report.json\"\n    },\n    {\n      \"type\": \"csv\",\n      \"path\": \"output/records.csv\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Reads Docker-bundled 3 CSV and 2 JSON records, runs count/sum/avg aggregations, writes JSON and CSV exports to job-specific output paths. Save the returned job_id automatically."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Create 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "const body = pm.response.json();",
                  "pm.test(\"Job ID returned\", () => pm.expect(body.job_id).to.be.a(\"string\").and.not.empty);",
                  "pm.test(\"Accepted state\", () => pm.expect(body.state).to.eql(\"PENDING\"));",
                  "pm.collectionVariables.set(\"jobId\", body.job_id);",
                  "pm.collectionVariables.set(\"pollCount\", \"0\");",
                  "pm.collectionVariables.unset(\"jobState\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02.02 - Get job details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/pipelines/{{jobId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Job details 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "const body = pm.response.json();",
                  "pm.test(\"Correct saved job\", () => pm.expect(body.job_id).to.eql(pm.collectionVariables.get(\"jobId\")));",
                  "pm.test(\"Includes status and spec\", () => { pm.expect(body.status).to.be.an(\"object\"); pm.expect(body.spec).to.be.an(\"object\"); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02.03 - Poll progress until terminal (Runner)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/pipelines/{{jobId}}/progress",
            "description": "When running this folder in Postman Collection Runner, repeats until COMPLETED/FAILED/CANCELLED, up to 30 attempts (~6 seconds). When using Send manually, repeat until terminal before requesting results."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Progress 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "const body = pm.response.json();",
                  "const states = [\"PENDING\", \"RUNNING\", \"COMPLETED\", \"FAILED\", \"CANCELLED\"];",
                  "pm.test(\"Valid job state\", () => pm.expect(states).to.include(body.state));",
                  "pm.test(\"Progress counters\", () => { pm.expect(body.records_read).to.be.a(\"number\"); pm.expect(body.records_processed).to.be.a(\"number\"); });",
                  "const terminal = [\"COMPLETED\", \"FAILED\", \"CANCELLED\"].includes(body.state);",
                  "if (terminal) {",
                  "pm.collectionVariables.set(\"jobState\", body.state);",
                  "pm.collectionVariables.set(\"pollCount\", \"0\");",
                  "pm.test(\"Sample job completed\", () => pm.expect(body.state).to.eql(\"COMPLETED\"));",
                  "pm.test(\"Five sample records read\", () => pm.expect(body.records_read).to.eql(5));",
                  "pm.test(\"Five sample records processed\", () => pm.expect(body.records_processed).to.eql(5));",
                  "} else {",
                  "const attempt = Number(pm.collectionVariables.get(\"pollCount\") || \"0\") + 1;",
                  "pm.collectionVariables.set(\"pollCount\", String(attempt));",
                  "if (attempt >= 30) {",
                  "pm.test(\"Sample job finishes within 30 polls\", () => pm.expect.fail(\"Still \" + body.state + \" after 30 polls\"));",
                  "pm.execution.setNextRequest(null);",
                  "} else {",
                  "pm.execution.setNextRequest(pm.info.requestName);",
                  "setTimeout(() => {}, 200);",
                  "}",
                  "}",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02.04 - Results and aggregations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/pipelines/{{jobId}}/results",
            "description": "Returns 409 if the async job has not finished; first run 02.03 until COMPLETED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Results 200 after completion\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "const body = pm.response.json();",
                  "pm.test(\"Five processed records\", () => pm.expect(body.records).to.have.lengthOf(5));",
                  "pm.test(\"Aggregation results\", () => pm.expect(body.aggregations).to.be.an(\"array\").and.have.lengthOf(7));",
                  "const avg = body.aggregations.find(a => a.name === \"average_amount\");",
                  "pm.test(\"Average amount 136.05\", () => { pm.expect(avg).to.exist; pm.expect(avg.value).to.be.closeTo(136.05, 0.001); });",
                  "pm.test(\"No sample job errors\", () => pm.expect(body.errors).to.have.lengthOf(0));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02.05 - Errors and failed records",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/pipelines/{{jobId}}/errors"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Errors endpoint 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "const body = pm.response.json();",
                  "pm.test(\"No failures for sample data\", () => { pm.expect(body.count).to.eql(0); pm.expect(body.failed_records).to.be.an(\"array\"); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02.06 - Paginated results (2 records)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/pipelines/{{jobId}}/results?offset=0&limit=2"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const b = pm.response.json(); pm.test(\"Pagination\", () => { pm.expect(b.records).to.have.lengthOf(2); pm.expect(b.total_records).to.eql(5); pm.expect(b.limit).to.eql(2); }); }"
                ]
              }
            }
          ]
        },
        {
          "name": "02.07 - List jobs (paginated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/pipelines?offset=0&limit=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const b = pm.response.json(); pm.test(\"Job list is paginated\", () => { pm.expect(b.jobs).to.be.an(\"array\"); pm.expect(b.total).to.be.a(\"number\"); pm.expect(b.limit).to.eql(10); }); }"
                ]
              }
            }
          ]
        },
        {
          "name": "02.08 - Check metrics after job",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/metrics"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Completed job metrics\", () => pm.expect(pm.response.text()).to.include(\"pipeline_jobs_finished_total{state=\\\"completed\\\"}\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Negative Tests",
      "description": "Safe validation/error scenarios. Assumes folder 02 has completed for the last test.",
      "item": [
        {
          "name": "03.01 - Reject missing sources",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/pipelines",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Invalid spec 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "03.02 - Reject malformed JSON",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/pipelines",
            "body": {
              "mode": "raw",
              "raw": "{\"sources\": [",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Malformed JSON 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "03.03 - Reject unknown field",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/pipelines",
            "body": {
              "mode": "raw",
              "raw": "{\"sources\":[{\"type\":\"csv\",\"endpoint\":\"testdata/input/customers.csv\"}],\"unexpected\":true}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Unexpected property 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "03.04 - Reject invalid pagination",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/pipelines?limit=0"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Invalid limit 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
