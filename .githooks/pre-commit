#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

printf 'Checking staged Go formatting...\n'
while IFS= read -r -d '' file; do
    case "$file" in
        *.go)
            diff_output=$(git show ":$file" | gofmt -d)
            if [[ -n "$diff_output" ]]; then
                printf 'Not gofmt-formatted: %s\n' "$file" >&2
                printf '%s\n' "$diff_output" >&2
                exit 1
            fi
            ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

printf 'Running go vet...\n'
go vet ./...

if ! command -v golangci-lint >/dev/null 2>&1; then
    printf 'golangci-lint v2 is required. Install it: https://golangci-lint.run/docs/welcome/install/local/\n' >&2
    exit 1
fi

printf 'Running golangci-lint...\n'
golangci-lint run ./...

printf 'Running Go tests...\n'
go test ./... -count=1

printf 'Pre-commit checks passed.\n'
