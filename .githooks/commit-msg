#!/usr/bin/env bash
set -euo pipefail

message_file=${1:-}
if [[ -z "$message_file" || ! -f "$message_file" ]]; then
    printf 'Git commit message file is missing.\n' >&2
    exit 1
fi

message=$(sed -n '/^[[:space:]]*#/d; /^[[:space:]]*$/d; {p;q;}' "$message_file")
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9][a-z0-9._/-]*\))?(!)?: .+'

case "$message" in
    Merge\ *|Revert\ \"*|fixup\!\ *|squash\!\ *) exit 0 ;;
esac

if [[ ! "$message" =~ $pattern ]]; then
    printf 'Invalid commit message: %s\n' "$message" >&2
    printf 'Use: type(scope): short description\n' >&2
    printf 'Example: feat(pipeline): add worker pool\n' >&2
    printf 'Allowed types: feat fix docs style refactor perf test build ci chore revert\n' >&2
    exit 1
fi
